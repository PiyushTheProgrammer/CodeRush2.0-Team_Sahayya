# AURA - Autonomous Unified Research Agent Environment Configuration

# Database Configuration (Supabase PostgreSQL with PgVector)
SUPABASE_DB_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/postgres
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# AI Model Provider API Keys
OPENAI_API_KEY=your_openai_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here

# Sandbox Configuration
DOCKER_IMAGE_NAME=aura-agent-runner:latest
